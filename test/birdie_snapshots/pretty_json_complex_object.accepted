{
  "bar": { "1": "3", "2": "4" },
  "empty": {},
  "foo": "bar",
  "key": [ { "some_numbers": [ 1, 2, 4, 5, 6, 7, 8, 9 ], "wibble": "wobble" } ],
  "key2": [
    null,
    { "some_numbers": [ 1, 2, 4, 5, 6, 7, 8, 9 ], "wibble": "wobble" }
  ],
  "tags": [ "hello", "hello", "hello", "hello" ],
  "times": [ 1, 2, 4, 5, 6, 7, 8, 9 ],
  "wibble": "wobble"
}
